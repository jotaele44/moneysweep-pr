{
  "extension_id": "financial-leaderboards-v1",
  "capabilities": [
    {
      "id": "financial-entity-leaderboards",
      "classification": "analysis",
      "status": "active",
      "requires_terminal": false,
      "rationale": "Diagnostic evidence-preserving financial rankings, frozen history, typed investigation signals and entity neighborhoods. Each measure has an explicit adapter/identity contract; unsupported or unmaterialized categories fail closed. MoneySweep exposes municipality references but does not claim geometry authority. Production federation promotion is separately bounded to a certified debt-issuance scope with exact package-hash trust.",
      "backend": {
        "files": [
          "server/backend/leaderboards.py",
          "server/backend/leaderboard_adapters.py",
          "server/backend/leaderboard_history.py",
          "server/backend/leaderboard_investigation.py",
          "server/backend/leaderboard_entities.py",
          "server/backend/main.py",
          "config/financial_category_ontology.json"
        ],
        "endpoints": [
          "GET /leaderboards/categories",
          "GET /leaderboards/top",
          "GET /leaderboards/history",
          "GET /leaderboards/movers",
          "GET /leaderboards/signals",
          "GET /leaderboards/entity/{entity_id}"
        ]
      },
      "analysis": {
        "files": [
          "scripts/materialize_leaderboard_snapshot.py",
          "scripts/materialize_leaderboard_git_snapshot.py",
          "scripts/certify_leaderboard_snapshot.py",
          "scripts/finalize_leaderboard_release.py",
          "scripts/export_leaderboard_package.py",
          "scripts/leaderboard_release_provenance.py",
          "data/manifests/leaderboards/leaderboard_certification_scope_v1.json",
          "data/manifests/leaderboards/debt_history_source_refs_v1.json",
          "schemas/leaderboard_export_package.schema.json"
        ]
      },
      "frontend": {
        "routes": ["/"],
        "e2e_routes": ["/"],
        "components": [
          "dashboard/src/lib/api.js",
          "dashboard/src/pages/Dashboard.jsx",
          "dashboard/src/components/FinancialLeaderboards.jsx"
        ],
        "discoverability": ["dashboard/src/pages/Dashboard.jsx"]
      },
      "tests": {
        "backend": [
          "tests/test_leaderboards.py",
          "tests/test_leaderboard_adapters.py",
          "tests/test_leaderboard_history.py",
          "tests/test_leaderboard_git_history.py",
          "tests/test_leaderboard_debt_history_expected.py",
          "tests/test_leaderboard_snapshot_certification.py",
          "tests/test_leaderboard_release_finalizer.py",
          "tests/test_leaderboard_release_provenance.py"
        ],
        "contract": ["tests/test_gui_parity.py"],
        "e2e": ["dashboard/tests/financial-leaderboards.spec.mjs"]
      }
    }
  ]
}
