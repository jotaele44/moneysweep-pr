# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/
.pytest_cache/
*.egg-info/
dist/
build/

# macOS metadata
.DS_Store

# Local git-stash reconciliation audit trails (developer-machine artifacts,
# not repo content — accidentally committed once, see repo history)
.stash-reconciliation/

# Coverage reports
.coverage
coverage.xml
htmlcov/

# Secrets — NEVER commit
.env
*.key

# Data — deny-all by default, then allow tracked artifact subtrees (RECS #2).
# Previous path-by-path denylist let blobs slip through when paths contained
# spaces or new nested dirs. The deny-all is the defensive posture; the
# explicit allow-list below is the policy for what's deliberately tracked.
#
# IMPORTANT: gitignore rules are order-sensitive and *later wins*. The deny-all
# `data/**` excludes subdirectories themselves, so every re-included subtree
# needs BOTH the directory un-ignore (`!data/<dir>/`) AND the contents
# un-ignore (`!data/<dir>/**`), and both must come AFTER `data/**`.

# Deny-all under data/ as the defensive posture
data/**

# Directory un-ignores (so git descends into these dirs; must come AFTER data/**)
!data/canonical_v1/
!data/exports/
!data/manifests/
!data/processed/
!data/reference/
!data/reports/
!data/review_queue/
!data/logs/
!data/staging/
!data/staging/expansion/
!data/staging/raw/
!data/staging/raw/**/
!data/staging/processed/
!data/staging/processed/**/
!data/raw/
!data/raw/**/
!data/manual/
!data/manual/**/
!data/raw/act_transition/
!data/raw/HigherGov/
!data/raw/documents/
!data/raw/follow_the_money/
!data/raw/torres_rosa_consultation/

# Content un-ignores for tracked artifact subtrees (small JSONs / manifests /
# status reports that are part of the audit trail and intentionally committed).
!data/canonical_v1/**
!data/exports/**
!data/manifests/**
!data/processed/**
!data/reference/**
!data/reports/**
!data/review_queue/**
!data/staging/expansion/DOWNLOAD_INSTRUCTIONS.md
!data/staging/expansion/manifest.json
!data/**/.gitkeep
# Dropzone operator instructions (gap-closure wave2b) — docs only, never data.
!data/raw/**/README.md

# Specific tracked raw drops (manual-source intakes already in history)
!data/raw/act_transition/**
!data/raw/HigherGov/**
!data/raw/documents/manifest.json
!data/raw/documents/index.csv
!data/raw/documents/**.csv
!data/raw/follow_the_money/**.json
!data/raw/follow_the_money/**.md
!data/raw/follow_the_money/**.csv
!data/raw/torres_rosa_consultation/**

# Cabilderos (lobbyist registry) + Donaciones (campaign donations) manual drops.
# Operator-delivered CSV extracts belong in git as part of the audit trail; the
# deny-all data/** above otherwise swallows them (only README.md/.gitkeep were
# re-included). Binary xlsx are intentionally NOT allow-listed here — keep large
# spreadsheet blobs out of git; commit their derived CSVs instead.
!data/raw/Cabilderos/**.csv
!data/raw/Donaciones/**.csv

# Donor-lookup reference exports (data/raw/reference/donantes_lookup/). git is
# allowed to descend into the tree (so the folder README, allow-listed above,
# is tracked), but the source files there are binary xlsx (potentially large)
# and stay OUT of git by policy. Track derived CSV summaries explicitly if any
# are produced later.
!data/raw/reference/
!data/raw/reference/**/
!data/raw/reference/donantes_lookup/**.csv

# Spaces-in-name dir kept for ACT/ACUDES transition PDFs already in history
# (#200's snake_case rename didn't reach this one). New files inside go through
# the same deny-by-extension rules as the rest of data/raw/.
!data/raw/Vigentes al Momento de Transición/
!data/raw/Vigentes al Momento de Transición/**.pdf

# Within allowed subtrees, still keep out enrichment outputs (may contain PII)
data/staging/processed/enrichment/**

# Contract Forensics V3 persistent memory. The engine writes a generated DuckDB
# database, parquet exports, and an extracted-text cache under data/forensics/;
# the deny-all data/** above already keeps those artifacts out of git. Re-include
# only the directory placeholders so the folders survive a fresh clone.
!data/forensics/
!data/forensics/.gitkeep
!data/forensics/parquet/
!data/forensics/parquet/.gitkeep

# Re-block heavyweight follow_the_money acquisition (must come AFTER the
# follow_the_money allowlist above so this specific file wins).
data/raw/follow_the_money/funding_flows_sf133.csv

# Logs and query cache stay out (specific .gitkeep allowance must follow)
data/logs/**
data/cache/**
!data/logs/.gitkeep
.claude/

# Machine-specific cypher-shell discovery output emitted by PREPA load launchers
outputs/**/cypher_shell_candidates.txt

# generated federation maintenance report (audit artifact, not committed)
reports/maintenance/

# Source update controller — track the canonical state + freshness snapshots,
# but keep runtime-heavy ledgers and temp output out of git (spec §20).
reports/source_update_runs.local.jsonl
reports/source_update_failures.local.jsonl
reports/source_update_consumed.local.json
reports/source_update_tmp/

# Contract Forensics V3 runtime reports (seed/pipeline/candidate outputs) — never committed
reports/forensics/

# Scratch output from .federation/check_gui_parity_with_extensions.py
artifacts/gui-capabilities-merged.json

# Desktop wrapper (see desktop/README.md)
dashboard/node_modules/
dashboard/dist/
desktop/.setup-complete
desktop/.frontend-source.json
desktop/last-setup.log
desktop/wheelhouse/
# Written by Fix-Gatekeeper.command's ad-hoc codesign into a tracked bundle.
PRII-MONEYSWEEP.app/Contents/_CodeSignature/
dist-desktop/
build/
desktop/.running
dist-smoke/

# Generated local-analysis run logs (agent scratch, not part of the committed
# audit trail — same posture as reports/maintenance/ above).
reports/local_analysis/

# Re-block .DS_Store inside the allow-listed data/ subtrees. The top-level
# .DS_Store rule (line 13) loses to the `!data/<dir>/**` re-includes, so it has
# to be restated here, after them — see this file's header note on later-wins.
data/**/.DS_Store
