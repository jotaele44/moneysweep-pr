{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://moneysweep-pr.local/schemas/operator_drop_manifest.schema.json",
  "title": "MoneySweep PR Operator Drop Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source_id",
    "obtained_at",
    "provenance",
    "files"
  ],
  "properties": {
    "schema_version": {
      "const": "moneysweep.operator_drop/v1"
    },
    "source_id": {
      "type": "string",
      "minLength": 1
    },
    "obtained_at": {
      "type": "string",
      "format": "date-time"
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_url",
        "retrieval_method"
      ],
      "properties": {
        "source_url": {
          "type": "string",
          "minLength": 1
        },
        "retrieval_method": {
          "type": "string",
          "minLength": 1
        },
        "snapshot_as_of": {
          "type": [
            "string",
            "null"
          ]
        },
        "notes": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256",
          "bytes"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    }
  }
}
