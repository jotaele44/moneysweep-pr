{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "canonical_v1/revenue_streams.schema.json",
  "title": "Canonical v1 — Revenue Stream",
  "description": "A civilian-paid infrastructure revenue stream such as tolls, fares, utility rates, or port fees.",
  "type": "object",
  "required": [
    "revenue_stream_id",
    "service_domain",
    "collecting_entity_id",
    "fiscal_year",
    "currency",
    "confidence"
  ],
  "properties": {
    "revenue_stream_id": {"type": "string", "pattern": "^revenue_[A-Za-z0-9_]+$"},
    "service_domain": {"type": "string", "minLength": 1},
    "collecting_entity_id": {"type": "string", "pattern": "^entity_[A-Za-z0-9_]+$"},
    "fiscal_year": {"type": "integer", "minimum": 1900, "maximum": 2100},
    "gross_revenue": {"type": "number", "minimum": 0.0},
    "currency": {"type": "string", "pattern": "^[A-Z]{3}$"},
    "pledged_debt_id": {"type": "string", "pattern": "^debt_[A-Za-z0-9_]+$"},
    "source_type": {"type": "string"},
    "confidence": {"type": "number", "minimum": 0.0, "maximum": 1.0},
    "evidence_id": {"type": "string", "pattern": "^evidence_[A-Za-z0-9_]+$"},
    "review_status": {"type": "string", "enum": ["accepted", "pending", "rejected"]},
    "notes": {"type": "string"}
  },
  "additionalProperties": false
}
