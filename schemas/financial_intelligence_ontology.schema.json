{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jotaele44/moneysweep-pr/schemas/financial_intelligence_ontology.schema.json",
  "title": "MoneySweep financial-intelligence ontology v1 (candidate)",
  "description": "Shape of registries/financial_intelligence_ontology_v1.json. Cross-field rules are enforced by moneysweep.financial_intelligence.ontology.validate_ontology.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "version", "status", "certification", "production_adoption", "baseline",
    "core_questions", "foundations", "domains", "priority_levels", "foreign_connection_classes",
    "flow_model", "entity_universe", "continuity_dimensions", "historical_scope", "capabilities",
    "infrastructure_classes", "source_authority_hierarchy", "source_authority_rules",
    "scope_policy", "prohibitions"
  ],
  "properties": {
    "schema_version": {"const": "financial_intelligence_ontology_v1"},
    "version": {"type": "string", "minLength": 1},
    "status": {"enum": ["CANDIDATE_NOT_ADOPTED", "ADOPTED"]},
    "certification": {"enum": ["WITHHELD", "PASS"]},
    "production_adoption": {"enum": ["BLOCKED", "AUTHORIZED"]},
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "commit", "captured_utc_date"],
      "properties": {
        "repository": {"type": "string"},
        "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "captured_utc_date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"}
      }
    },
    "core_questions": {"type": "array", "minItems": 6, "maxItems": 6, "items": {"type": "string", "minLength": 1}},
    "foundations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "module", "role", "status"],
        "properties": {
          "id": {"type": "string", "pattern": "^F[0-9]{2}$"},
          "name": {"type": "string", "minLength": 1},
          "module": {"type": ["string", "null"]},
          "symbols": {"type": "array", "items": {"type": "string"}},
          "paths": {"type": "array", "items": {"type": "string"}},
          "role": {"type": "string", "minLength": 1},
          "status": {"enum": ["EXISTING_REUSED", "NEW_CANDIDATE"]}
        }
      }
    },
    "domains": {
      "type": "array",
      "minItems": 25,
      "maxItems": 25,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "coverage", "priority", "reuses_foundations", "existing_assets", "population_state"],
        "properties": {
          "id": {"type": "string", "pattern": "^MS(0[1-9]|1[0-9]|2[0-5])$"},
          "name": {"type": "string", "minLength": 1},
          "coverage": {"type": "string", "minLength": 1},
          "priority": {"type": "string"},
          "reuses_foundations": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^F[0-9]{2}$"}},
          "existing_assets": {"type": "array", "items": {"type": "string"}},
          "population_state": {"enum": ["DEFINED_NOT_POPULATED", "PARTIALLY_POPULATED", "POPULATED_UNCERTIFIED", "CERTIFIED"]},
          "note": {"type": "string"}
        }
      }
    },
    "priority_levels": {"type": "object", "additionalProperties": {"type": "string"}},
    "foreign_connection_classes": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "coverage", "kernel_binding"],
        "properties": {
          "id": {"type": "string", "pattern": "^FC0[1-9]$"},
          "name": {"type": "string"},
          "coverage": {"type": "string"},
          "kernel_binding": {"type": "string"}
        }
      }
    },
    "flow_model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["note", "geographic_axis", "geographic_fallbacks", "characters", "mutually_exclusive_characters"],
      "properties": {
        "note": {"type": "string"},
        "geographic_axis": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "object", "required": ["id", "examples", "rule"]}},
        "geographic_fallbacks": {"type": "array", "items": {"type": "string"}},
        "characters": {"type": "array", "minItems": 5, "maxItems": 5, "items": {"type": "object", "required": ["id", "examples", "cash_movement"]}},
        "mutually_exclusive_characters": {"type": "array", "items": {"type": "array", "items": {"type": "string"}}}
      }
    },
    "entity_universe": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["group", "kinds"],
        "properties": {
          "group": {"type": "string"},
          "restriction": {"type": "string"},
          "kinds": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["name", "node_kind"], "properties": {"name": {"type": "string"}, "node_kind": {"type": "string"}}}}
        }
      }
    },
    "continuity_dimensions": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "states", "fallback_states"],
        "properties": {
          "id": {"type": "string"},
          "states": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "fallback_states": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "historical_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["baseline_year", "earlier_evidence", "periods_are_mutually_exclusive", "periods"],
      "properties": {
        "baseline_year": {"type": "integer"},
        "earlier_evidence": {"type": "string"},
        "periods_are_mutually_exclusive": {"const": false},
        "periods": {
          "type": "array",
          "minItems": 7,
          "maxItems": 7,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "start_year", "end_year", "name", "coverage"],
            "properties": {
              "id": {"type": "string"},
              "start_year": {"type": "integer"},
              "end_year": {"type": ["integer", "null"]},
              "name": {"type": "string"},
              "coverage": {"type": "string"}
            }
          }
        }
      }
    },
    "capabilities": {
      "type": "array",
      "minItems": 20,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "purpose", "requires_foundations", "state", "guardrail"],
        "properties": {
          "id": {"type": "string", "pattern": "^CAP[0-9]{2}$"},
          "name": {"type": "string"},
          "purpose": {"type": "string"},
          "requires_foundations": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "state": {"enum": ["SPECIFIED_NOT_IMPLEMENTED", "CANDIDATE_PRIMITIVE", "PARTIAL_EXISTING", "IMPLEMENTED_UNCERTIFIED", "CERTIFIED"]},
          "guardrail": {"type": "string", "minLength": 1}
        }
      }
    },
    "infrastructure_classes": {
      "type": "array",
      "minItems": 14,
      "maxItems": 14,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "financial_intelligence", "identity_owner_candidate", "owner_state"],
        "properties": {
          "id": {"type": "string", "pattern": "^INF[0-9]{2}$"},
          "name": {"type": "string"},
          "financial_intelligence": {"type": "string"},
          "identity_owner_candidate": {"type": ["string", "null"]},
          "owner_state": {"enum": ["UNASSIGNED", "CANDIDATE_UNRATIFIED", "RATIFIED"]},
          "note": {"type": "string"}
        }
      }
    },
    "source_authority_hierarchy": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["rank", "id", "evidence_tier", "description", "may_establish"],
        "properties": {
          "rank": {"type": "integer", "minimum": 1},
          "id": {"type": "string"},
          "evidence_tier": {"enum": ["T1", "T2", "T3", "T4"]},
          "description": {"type": "string"},
          "may_establish": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "source_authority_rules": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "scope_policy": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "items": {"type": "object", "additionalProperties": false, "required": ["requirement", "policy"], "properties": {"requirement": {"type": "string"}, "policy": {"type": "string"}}}
    },
    "prohibitions": {"type": "array", "minItems": 1, "items": {"type": "string"}}
  }
}
