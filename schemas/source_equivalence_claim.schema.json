{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://moneysweep-pr.local/schemas/source_equivalence_claim.schema.json",
  "title": "MoneySweep PR Source Equivalence Claim",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source_id",
    "candidate_source",
    "tests",
    "missing_fields",
    "extra_fields",
    "evidence"
  ],
  "properties": {
    "schema_version": {
      "const": "moneysweep.source_equivalence/v1"
    },
    "source_id": {
      "type": "string",
      "minLength": 1
    },
    "candidate_source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "source_url", "authoritative"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "source_url": {"type": "string", "minLength": 1},
        "authoritative": {"type": "boolean"}
      }
    },
    "tests": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "semantic_scope_match",
        "temporal_scope_match",
        "row_universe_match",
        "field_mapping_complete",
        "selection_equivalent",
        "aggregation_equivalent"
      ],
      "properties": {
        "semantic_scope_match": {"type": "boolean"},
        "temporal_scope_match": {"type": "boolean"},
        "row_universe_match": {"type": "boolean"},
        "field_mapping_complete": {"type": "boolean"},
        "selection_equivalent": {"type": "boolean"},
        "aggregation_equivalent": {"type": "boolean"}
      }
    },
    "missing_fields": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true
    },
    "extra_fields": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "locator", "sha256"],
        "properties": {
          "kind": {"type": "string", "minLength": 1},
          "locator": {"type": "string", "minLength": 1},
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "notes": {"type": "string"}
  }
}
